WITH booking_errors AS (SELECT COUNT(DISTINCT t.transcript_id) AS total_booking_errors FROM transcripts t WHERE t.domain IN ('Hotel', 'Flight') AND 'BOOKING_ERROR' = ANY(t.issue_categories)), refunds_for_booking_errors AS (SELECT COUNT(DISTINCT t.transcript_id) AS total_refunds FROM transcripts t WHERE t.domain IN ('Hotel', 'Flight') AND 'BOOKING_ERROR' = ANY(t.issue_categories) AND 'REFUND_INQUIRY' = ANY(t.issue_categories)) SELECT (refunds_for_booking_errors.total_refunds::float / booking_errors.total_booking_errors::float) * 100 AS percentage FROM booking_errors, refunds_for_booking_errors;
